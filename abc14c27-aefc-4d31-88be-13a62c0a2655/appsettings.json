{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=used_vehicle_transaction;User=root;Password=root;CharSet=utf8mb4;Allow User Variables=true;",
    "RedisConnection": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AppSettings": {
    "DefaultCulture": "zh-CN",
    "SupportCultures": [ "zh-CN", "en-US" ],
    "FileStoragePath": "/data/vehicle-archives",
    "MaxFileSizeMB": 50,
    "AllowedFileExtensions": [ ".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx" ],
    "ComplianceCheckTimeoutMs": 2800,
    "InspectionReportTimeoutMs": 4800,
    "ArchiveSearchTimeoutMs": 1800,
    "JwtSecret": "UsedVehicleTransactionSuperSecretKeyForJwtTokenGeneration2024",
    "JwtIssuer": "UsedVehicleTransactionSystem",
    "JwtAudience": "UsedVehicleTransactionUsers"
  },
  "ExternalApis": {
    "EnvProtectionApi": {
      "BaseUrl": "https://env-protection.example.com/api",
      "ApiKey": "ENV-API-KEY-PLACEHOLDER",
      "TimeoutMs": 800
    },
    "AccidentRecordApi": {
      "BaseUrl": "https://accident-records.example.com/api",
      "ApiKey": "ACC-API-KEY-PLACEHOLDER",
      "TimeoutMs": 800
    },
    "MortgageApi": {
      "BaseUrl": "https://mortgage-check.example.com/api",
      "ApiKey": "MORT-API-KEY-PLACEHOLDER",
      "TimeoutMs": 800
    },
    "SeizureApi": {
      "BaseUrl": "https://seizure-check.example.com/api",
      "ApiKey": "SEZ-API-KEY-PLACEHOLDER",
      "TimeoutMs": 800
    },
    "VehicleInfoApi": {
      "BaseUrl": "https://vehicle-info.example.com/api",
      "ApiKey": "VINFO-API-KEY-PLACEHOLDER",
      "TimeoutMs": 800
    },
    "TaxApi": {
      "BaseUrl": "https://tax-system.example.com/api",
      "ApiKey": "TAX-API-KEY-PLACEHOLDER",
      "TimeoutMs": 800
    }
  }
}
