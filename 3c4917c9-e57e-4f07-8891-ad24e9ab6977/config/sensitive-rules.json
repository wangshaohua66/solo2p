  "maskingRules": {
    "default": {
      "visibleStart": 2,
      "visibleEnd": 2,
      "maskChar": "*",
      "minLengthToMask": 8
    },
    "password": {
      "visibleStart": 0,
      "visibleEnd": 0,
      "maskChar": "*",
      "fixedLength": 12
    },
    "api_key": {
      "visibleStart": 4,
      "visibleEnd": 4,
      "maskChar": "*"
    },
    "private_key": {
      "visibleStart": 0,
      "visibleEnd": 0,
      "maskChar": "*",
      "fixedLength": 20
    },
    "id_card": {
      "visibleStart": 6,
      "visibleEnd": 4,
      "maskChar": "*"
    },
    "bank_card": {
      "visibleStart": 4,
      "visibleEnd": 4,
      "maskChar": "*"
    },
    "phone": {
      "visibleStart": 3,
      "visibleEnd": 4,
      "maskChar": "*"
    },
    "email": {
      "visibleStart": 2,
      "visibleEnd": 0,
      "maskChar": "*",
      "keepDomain": true
    }
  },
  "kmsIntegration": {
    "supportedProviders": [
