    "envVars": {
      "vaultAddress": "VAULT_ADDR",
      "vaultToken": "VAULT_TOKEN",
      "aliyunKmsEndpoint": "ALIYUN_KMS_ENDPOINT",
      "awsRegion": "AWS_DEFAULT_REGION",
      "azureKeyVaultUri": "AZURE_KEY_VAULT_URI",
      "gcpProjectId": "GCP_PROJECT_ID"
    }
  }
