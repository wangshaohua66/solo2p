# ===== 浏览器配置 =====
HEADLESS_MODE=true
MAX_BROWSER_INSTANCES=4
BROWSER_TYPE=chrome
PAGE_LOAD_TIMEOUT=30000
SCRIPT_TIMEOUT=20000

# ===== 抓取配置 =====
MAX_RETRY_TIMES=3
RETRY_DELAY_BASE=30000
REQUEST_DELAY_MIN=2000
REQUEST_DELAY_MAX=5000

# ===== 续保监控配置 =====
RENEWAL_CHECK_CRON=0 9 * * *
RENEWAL_DAYS_WARNING_1=30
RENEWAL_DAYS_WARNING_2=15
RENEWAL_DAYS_WARNING_3=7
RATE_INCREASE_THRESHOLD=10

# ===== 8家保险公司登录配置 =====
# 人保
PICC_USERNAME=your_picc_username
PICC_PASSWORD=your_picc_password
PICC_LOGIN_URL=https://ebiz.picc.com/

# 平安
PINGAN_USERNAME=your_pingan_username
PINGAN_PASSWORD=your_pingan_password
PINGAN_LOGIN_URL=https://insurance.pingan.com/

# 太保
CPIC_USERNAME=your_cpic_username
CPIC_PASSWORD=your_cpic_password
CPIC_LOGIN_URL=https://www.cpic.com.cn/

# 国寿
CHINALIFE_USERNAME=your_chinalife_username
CHINALIFE_PASSWORD=your_chinalife_password
CHINALIFE_LOGIN_URL=https://www.e-chinalife.com/

# 泰康
TAIKANG_USERNAME=your_taikang_username
TAIKANG_PASSWORD=your_taikang_password
TAIKANG_LOGIN_URL=https://www.taikang.com/

# 新华
NEWCHINA_USERNAME=your_newchina_username
NEWCHINA_PASSWORD=your_newchina_password
NEWCHINA_LOGIN_URL=https://www.newchinalife.com/

# 阳光
SINOYANG_USERNAME=your_sinoyang_username
SINOYANG_PASSWORD=your_sinoyang_password
SINOYANG_LOGIN_URL=https://www.sinosig.com/

# 中华
CHINAACI_USERNAME=your_chinaaci_username
CHINAACI_PASSWORD=your_chinaaci_password
CHINAACI_LOGIN_URL=https://www.china-insurance.com/

# ===== 日志配置 =====
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=50m
LOG_MAX_FILES=30d

# ===== 输出配置 =====
OUTPUT_DIR=./output
EXCEL_TEMPLATE_DIR=./templates
