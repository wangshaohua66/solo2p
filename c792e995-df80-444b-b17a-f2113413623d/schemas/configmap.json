{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kubernetes ConfigMap Schema",
  "allOf": [
    { "$ref": "./base.json" },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ConfigMap"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "binaryData": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "immutable": {
          "type": "boolean"
        }
      }
    }
  ]
}
