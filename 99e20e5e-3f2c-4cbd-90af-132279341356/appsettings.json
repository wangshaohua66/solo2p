{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Port=3306;Database=fire_iot_platform;User=root;Password=root;Charset=utf8mb4;Pooling=true;Max Pool Size=100;Min Pool Size=10;",
    "RedisConnection": "localhost:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000,asyncTimeout=5000"
  },
  "RedisSettings": {
    "InstanceName": "FireIoT:",
    "DefaultExpiryMinutes": 30,
    "HeartbeatExpirySeconds": 35
  },
  "MqttSettings": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "FireIoTPlatform",
    "UserName": "admin",
    "Password": "admin",
    "TopicPrefix": "fire/device/"
  },
  "SignalRSettings": {
    "EnableDetailedErrors": true,
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutIntervalSeconds": 30
  },
  "DeviceSettings": {
    "HeartbeatIntervalSeconds": 30,
    "OfflineThresholdSeconds": 90,
    "MaxConcurrentDevices": 50000
  },
  "AlarmSettings": {
    "PushDelaySeconds": 5,
    "MultiDeviceAlarmWindowSeconds": 30,
    "MultiDeviceAlarmCount": 2,
    "HistoryRetentionMonths": 36
  },
  "JwtSettings": {
    "Issuer": "FireIoTPlatform",
    "Audience": "FireIoTPlatform",
    "SecretKey": "FireIoTPlatform2024SuperSecretKeyForJwtTokenAuthentication",
    "ExpiryHours": 24
  },
  "ApiSettings": {
    "GovernmentApiBaseUrl": "https://gov-api.example.com",
    "GovernmentApiKey": "your-government-api-key",
    "FireCommandCenterBaseUrl": "https://119.example.com",
    "FireCommandCenterApiKey": "your-fire-command-api-key"
  }
}
