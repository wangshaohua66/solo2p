SERVER_PORT=8080
SERVER_MODE=development
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=smart_lighting
MYSQL_MAX_OPEN_CONNS=100
MYSQL_MAX_IDLE_CONNS=20
MYSQL_MAX_LIFETIME=3600

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE=10

JWT_SECRET=smart-lighting-jwt-secret-key-2024
JWT_EXPIRE_HOURS=12
JWT_ISSUER=smart-lighting-api

LOG_LEVEL=info
LOG_FILENAME=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=30
LOG_MAX_AGE=30
LOG_COMPRESS=true

APP_DEVICE_SCAN_INTERVAL=5
APP_ENERGY_CALC_HOUR=2
APP_DATA_RETENTION_DAYS=180
APP_BATCH_CONTROL_SIZE=5000
APP_COMMAND_TIMEOUT=60
