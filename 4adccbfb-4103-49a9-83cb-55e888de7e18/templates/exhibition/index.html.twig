{% extends 'base.html.twig' %}
{% block title %}展会管理{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h4><i class="bi bi-calendar2-event text-accent"></i> 展会管理</h4>
        <div class="sub">管理展会全生命周期：创建、招商、布展、开展、收尾</div>
    </div>
    <a href="{{ path('app_exhibition_new') }}" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i> 创建展会</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr><th>展会名称</th><th>类型</th><th>场馆</th><th>展期</th><th>展位</th><th>合同</th><th>状态</th><th class="text-end">操作</th></tr>
            </thead>
            <tbody>
            {% for row in rows %}
                {% set e = row.exhibition %}
                <tr>
                    <td class="fw-semibold">{{ e.name }}</td>
                    <td><span class="tag-pill"><i class="bi bi-tag"></i> {{ e.type }}</span></td>
                    <td class="text-muted">{{ e.hall }}</td>
                    <td>{{ e.startDate|date('m/d') }} - {{ e.endDate|date('m/d') }}</td>
                    <td>{{ row.booked }}/{{ row.booths }}</td>
                    <td>{{ row.contracts }}</td>
                    <td><span class="badge status-badge status-{{ e.status }}">{{ e.statusLabel }}</span></td>
                    <td class="text-end">
                        <a href="{{ path('app_exhibition_show', {id: e.id}) }}" class="btn btn-sm btn-outline-deep">详情</a>
                        <a href="{{ path('app_exhibition_select', {id: e.id}) }}" class="btn btn-sm btn-outline-accent">切换</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="empty-state"><i class="bi bi-calendar2-x"></i><p class="mb-0">暂无展会，点击右上角创建</p></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
