{% extends 'base.html.twig' %}
{% block title %}工单详情{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h4><i class="bi bi-headset text-accent"></i> 工单 #{{ o.id }}</h4>
        <div class="sub">{{ o.category }} · {{ o.exhibitor.name }} · {{ o.createdAt|date('Y-m-d H:i') }}</div>
    </div>
    <span class="badge status-badge status-{{ o.status }} fs-6">{{ o.statusLabel }}</span>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-info-circle text-accent me-2"></i>工单信息</div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><td class="text-muted" style="width:120px">服务类别</td><td><span class="tag-pill"><i class="bi bi-tools"></i> {{ o.category }}</span></td></tr>
                    <tr><td class="text-muted">参展商</td><td class="fw-semibold">{{ o.exhibitor.name }}</td></tr>
                    <tr><td class="text-muted">服务商</td><td>{{ o.provider ? o.provider.name : '<span class="text-muted">待派单</span>' }}</td></tr>
                    <tr><td class="text-muted">费用</td><td class="fw-bold text-accent">¥{{ o.fee|number_format(0,'.',',') }}</td></tr>
                    <tr><td class="text-muted">登记时间</td><td>{{ o.createdAt|date('Y-m-d H:i') }}</td></tr>
                    <tr><td class="text-muted">备注</td><td>{{ o.note ?: '-' }}</td></tr>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="bi bi-clock-history text-accent me-2"></i>工单进度</div>
            <div class="card-body">
                <ul class="timeline">
                    <li><div class="fw-semibold">工单已登记</div><div class="tl-time">{{ o.createdAt|date('m-d H:i') }}</div></li>
                    {% if o.status == 'accepted' or o.status == 'done' %}<li><div class="fw-semibold">服务商已接单</div></li>{% endif %}
                    {% if o.status == 'done' %}<li><div class="fw-semibold">服务已完成</div></li>{% endif %}
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><i class="bi bi-lightning-charge text-accent me-2"></i>操作</div>
            <div class="card-body d-grid gap-2">
                {% if o.status == 'pending' and (role == 'provider' or role == 'organizer') %}
                <button class="btn btn-accent" data-exh-post="{{ path('app_service_accept', {id: o.id}) }}" data-confirm="确认接单并开始执行？"><i class="bi bi-check2 me-1"></i>接单</button>
                {% elseif o.status == 'accepted' and (role == 'provider' or role == 'organizer') %}
                <button class="btn btn-accent" data-exh-post="{{ path('app_service_progress', {id: o.id}) }}" data-exh-params="to=done" data-confirm="确认该服务已完成？"><i class="bi bi-check2-all me-1"></i>标记完成</button>
                {% elseif o.status == 'done' %}
                <div class="text-center text-muted py-3"><i class="bi bi-check-circle fs-3 text-success d-block mb-2"></i>工单已完成</div>
                {% else %}
                <div class="text-center text-muted py-3"><i class="bi bi-info-circle fs-3 d-block mb-2"></i>当前角色无可用操作</div>
                {% endif %}
                <a href="{{ path('app_service_dispatch') }}" class="btn btn-outline-deep"><i class="bi bi-kanban me-1"></i>调度看板</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
