<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>{% block title %}观众服务{% endblock %} · 会展中心</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('assets/app.css') }}" rel="stylesheet">
    <style>
        body{background:linear-gradient(160deg,#0B2A4A 0%,#163d63 100%);min-height:100vh}
        .pub-shell{max-width:430px;margin:0 auto;padding:0 14px 30px}
        .pub-card{background:#fff;border-radius:18px;box-shadow:0 18px 50px rgba(0,0,0,.25);overflow:hidden;margin-top:20px}
        .pub-head{padding:22px 20px 14px;text-align:center;color:#fff}
        .pub-head .brand{display:flex;align-items:center;justify-content:center;gap:8px;font-size:18px;font-weight:800}
        .pub-head .brand i{color:#FF6A13}
        .pub-body{padding:20px}
        .pub-foot{text-align:center;padding:14px;color:rgba(255,255,255,.7);font-size:12px}
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="pub-shell">
    <div class="pub-head">
        <div class="brand"><i class="bi bi-buildings-fill"></i> 会展中心观众服务</div>
        <div class="small mt-1 opacity-75">{% block pub_sub %}{% endblock %}</div>
    </div>
    <div class="pub-card">
        <div class="pub-body">
            {% block body %}{% endblock %}
        </div>
    </div>
    <div class="pub-foot">© 会展中心运营管理系统 · 观众端</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>window.CSRF_TOKEN = "{{ csrf_token('api') }}";</script>
<script src="{{ asset('assets/app.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
