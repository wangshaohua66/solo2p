{% extends 'base.html.twig' %}
{% block title %}工作台{% endblock %}

{% block body %}
{% if not ex %}
<div class="empty-state card">
    <i class="bi bi-calendar2-x"></i>
    <h5 class="mb-2">尚未创建任何展会</h5>
    <p class="text-muted mb-3">创建第一场展会，开始管理展位、合同、服务工单与观众登记。</p>
    <a href="{{ path('app_exhibition_new') }}" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i> 创建展会</a>
</div>
{% else %}
<div class="page-head">
    <div>
        <h4><i class="bi bi-speedometer2 text-accent"></i> 工作台</h4>
        <div class="sub">{{ ex.name }} · {{ ex.hall }} · {{ ex.startDate|date('Y-m-d') }} 至 {{ ex.endDate|date('Y-m-d') }}</div>
    </div>
    <div>
        <span class="badge status-badge status-{{ ex.status }}">{{ ex.statusLabel }}</span>
        <span class="tag-pill ms-2"><i class="bi bi-tag"></i> {{ ex.type }}</span>
    </div>
</div>

<div class="kpi-grid mb-4">
    <div class="stat-card">
        <i class="bi bi-grid stat-icon text-accent"></i>
        <div class="stat-label">展位出租率</div>
        <div class="stat-value">{{ stats.occupancy }}<span class="fs-5">%</span></div>
        <div class="stat-trend text-muted">已订 {{ stats.booked }} / {{ stats.boothTotal }} 个展位</div>
    </div>
    <div class="stat-card">
        <i class="bi bi-cash-coin stat-icon text-success"></i>
        <div class="stat-label">合同签约额</div>
        <div class="stat-value">{{ stats.revenue|number_format(0, '.', ',') }}</div>
        <div class="stat-trend text-muted">含已签章 + 已付款</div>
    </div>
    <div class="stat-card">
        <i class="bi bi-people stat-icon text-info"></i>
        <div class="stat-label">实时入场人数</div>
        <div class="stat-value">{{ stats.visitors }}</div>
        <div class="stat-trend text-muted">Redis 实时计数</div>
    </div>
    <div class="stat-card">
        <i class="bi bi-check2-square stat-icon text-warning"></i>
        <div class="stat-label">工单完成率</div>
        <div class="stat-value">{{ stats.orderRate }}<span class="fs-5">%</span></div>
        <div class="stat-trend text-muted">完成 {{ stats.orderDone }} / {{ stats.orderTotal }} 单</div>
    </div>
</div>

<div class="row-cards">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-file-earmark-text text-accent me-2"></i>待审批合同</span>
            <a href="{{ path('app_contract_index') }}" class="btn btn-sm btn-outline-deep">全部</a>
        </div>
        <div class="card-body p-0">
            {% if pendingApprovals is empty %}
            <div class="empty-state py-4"><i class="bi bi-check-circle"></i><p class="mb-0">暂无待审批合同</p></div>
            {% else %}
            <table class="table table-hover mb-0">
                <thead><tr><th>合同号</th><th>参展商</th><th>金额</th><th>状态</th></tr></thead>
                <tbody>
                {% for c in pendingApprovals %}
                <tr style="cursor:pointer" onclick="location='{{ path('app_contract_show', {id: c.id}) }}'">
                    <td class="fw-semibold">{{ c.code }}</td>
                    <td>{{ c.exhibitor.name }}</td>
                    <td class="fw-bold text-accent">¥{{ c.amount|number_format(0,'.',',') }}</td>
                    <td><span class="badge status-badge status-{{ c.status }}">{{ c.statusLabel }}</span></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-headset text-accent me-2"></i>最新服务工单</span>
            <a href="{{ path('app_service_index') }}" class="btn btn-sm btn-outline-deep">全部</a>
        </div>
        <div class="card-body p-0">
            {% if recentOrders is empty %}
            <div class="empty-state py-4"><i class="bi bi-inbox"></i><p class="mb-0">暂无服务工单</p></div>
            {% else %}
            <table class="table table-hover mb-0">
                <thead><tr><th>类别</th><th>参展商</th><th>费用</th><th>状态</th></tr></thead>
                <tbody>
                {% for o in recentOrders %}
                <tr style="cursor:pointer" onclick="location='{{ path('app_service_show', {id: o.id}) }}'">
                    <td><span class="tag-pill"><i class="bi bi-tools"></i> {{ o.category }}</span></td>
                    <td>{{ o.exhibitor.name }}</td>
                    <td class="fw-bold">¥{{ o.fee|number_format(0,'.',',') }}</td>
                    <td><span class="badge status-badge status-{{ o.status }}">{{ o.statusLabel }}</span></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>
</div>

<div class="row-cards mt-3">
    <div class="card">
        <div class="card-header"><i class="bi bi-file-earmark-text text-accent me-2"></i>最近合同</div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead><tr><th>合同号</th><th>展位</th><th>金额</th><th>状态</th></tr></thead>
                <tbody>
                {% for c in recentContracts %}
                <tr style="cursor:pointer" onclick="location='{{ path('app_contract_show', {id: c.id}) }}'">
                    <td class="fw-semibold">{{ c.code }}</td>
                    <td>{{ c.booth.code }}</td>
                    <td class="fw-bold text-accent">¥{{ c.amount|number_format(0,'.',',') }}</td>
                    <td><span class="badge status-badge status-{{ c.status }}">{{ c.statusLabel }}</span></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><i class="bi bi-lightning-charge text-accent me-2"></i>快捷操作</div>
        <div class="card-body d-grid gap-2">
            <a href="{{ path('app_booth_index') }}" class="btn btn-outline-deep text-start"><i class="bi bi-grid-1x2 me-2"></i>展位平面图与分配</a>
            <a href="{{ path('app_contract_index') }}" class="btn btn-outline-deep text-start"><i class="bi bi-file-earmark-plus me-2"></i>新建展位租赁合同</a>
            <a href="{{ path('app_service_new') }}" class="btn btn-outline-deep text-start"><i class="bi bi-plus-circle me-2"></i>登记服务工单</a>
            <a href="{{ path('app_visitor_index') }}" class="btn btn-outline-deep text-start"><i class="bi bi-qr-code me-2"></i>观众票务与登记</a>
            <a href="{{ path('app_dashboard') }}" class="btn btn-accent text-start"><i class="bi bi-graph-up-arrow me-2"></i>打开数据看板</a>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
