# ============================================================
# 药品合规监控系统 - 环境变量示例
# 请复制为 .env 并填入实际值
# ============================================================

# 基础配置
NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Shanghai

# 数据库连接
MONGO_URI=mongodb://localhost:27017/drug_compliance
MONGO_DB=drug_compliance
REDIS_URI=redis://localhost:6379

# Chrome / Selenium
HEADLESS=true
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
DISABLE_WEB_SECURITY=false

# ======== 平台账号密码 (请妥善保管，勿提交至代码库) ========

# 1. 国家药品监督管理局 (NMPA)
NMPA_PASS_01=your_nmpa_password_01
NMPA_PASS_02=your_nmpa_password_02

# 2. 省级药监抽检公示平台
PROV_SAMPLING_PASS_01=your_sampling_password

# 3. 省药品集中采购交易中心
PROCURE_PASS_01=your_procure_password_01
PROCURE_PASS_02=your_procure_password_02

# 4. 国家药品不良反应监测中心
ADR_PASS_01=your_adr_password

# 5. 江苏省药械审评审批系统
JS_EDA_PASS_01=your_js_eda_password

# 6. 浙江省药械审评审批系统
ZJ_MPA_PASS_01=your_zj_mpa_password

# 7. 上海市药械审评审批系统
SH_FDA_PASS_01=your_sh_fda_password

# 8. 安徽省药械审评审批系统
AH_MPA_PASS_01=your_ah_mpa_password

# 邮件通道 (可选)
SMTP_HOST=smtp.exmail.qq.com
SMTP_USER=compliance@drug-group.com
SMTP_PASS=your_smtp_password

# 运行模式
ALLOW_NO_DB=false
CONFIG_DIR=/app/config
