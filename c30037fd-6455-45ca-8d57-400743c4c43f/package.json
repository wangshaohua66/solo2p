{
  "name": "drug-compliance-monitor",
  "version": "1.0.0",
  "description": "药品合规数据采集与监控系统 - 多平台自动采集、告警、报告生成",
  "main": "src/launcher.js",
  "scripts": {
    "start": "node src/launcher.js",
    "cli": "node src/cli/index.js",
    "report:weekly": "node src/cli/index.js --command report --type weekly",
    "report:monthly": "node src/cli/index.js --command report --type monthly",
    "test": "node --test tests/",
    "lint": "eslint src/ --ext .js",
    "docker:build": "docker build -t drug-compliance-monitor .",
    "docker:run": "docker run -v ./config:/app/config -v ./logs:/app/logs -v ./reports:/app/reports drug-compliance-monitor"
  },
  "dependencies": {
    "selenium-webdriver": "^4.18.0",
    "webdriverio": "^8.36.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ioredis": "^5.3.2",
    "mongodb": "^6.3.0",
    "js-yaml": "^4.1.0",
    "chokidar": "^3.5.3",
    "cli-table3": "^0.6.3",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "terminal-image": "^2.0.0",
    "ejs": "^3.1.9",
    "puppeteer-core": "^21.7.0",
    "pdf-creator-node": "^2.3.5",
    "date-fns": "^3.3.1",
    "uuid": "^9.0.1",
    "p-queue": "^6.6.2",
    "eventsource": "^2.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Compliance Team",
  "license": "MIT"
}
