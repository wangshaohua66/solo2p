{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SQLite": "Data Source=HazChemSupervision.db;Cache=Shared;"
  },
  "Jwt": {
    "Key": "HazChemSupervision_SecretKey_2024_VeryLongSecurityKeyForJWT",
    "Issuer": "HazChemSupervision",
    "Audience": "HazChemSupervisionUsers",
    "ExpireMinutes": 1440
  },
  "Performance": {
    "WarningThresholdMs": 200,
    "ErrorThresholdMs": 500
  },
  "Alert": {
    "InventoryOverstockThreshold": 0.9,
    "InventoryLowStockThreshold": 0.1,
    "NearExpiryDays": 30,
    "RouteDeviationMeters": 500,
    "SpeedLimitKmh": 80,
    "TemperatureMinC": -10,
    "TemperatureMaxC": 40,
    "TransportDeviationDurationSec": 180,
    "TransportOverspeedDurationSec": 180,
    "CertificateExpiringDays": 30,
    "HazardEscalationDays": 3,
    "BackgroundCheckIntervalMinutes": 5
  },
  "CertificateVerification": {
    "ApiBaseUrl": "https://cert.mem.gov.cn/api/v1",
    "ApiKey": "demo-api-key-please-replace",
    "TimeoutSeconds": 10
  }
}
