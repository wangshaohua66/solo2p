{
    "name": "guangying/cinema-backend",
    "description": "光影院线运营管理平台 - PHP 8.2 + Symfony 6.4 + Doctrine ODM 2.5 + MongoDB 7.0",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mongodb": "*",
        "ext-json": "*",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/yaml": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/serializer": "6.4.*",
        "symfony/property-access": "6.4.*",
        "symfony/property-info": "6.4.*",
        "symfony/cors-bundle": "^2.4",
        "doctrine/mongodb-odm-bundle": "^5.1",
        "doctrine/mongodb-odm": "2.5.*",
        "mongodb/mongodb": "^1.17",
        "firebase/php-jwt": "^6.10",
        "cboden/ratchet": "^0.4.4",
        "symfony/monolog-bundle": "^3.10",
        "nelmio/api-doc-bundle": "^4.26",
        "symfony/twig-bundle": "6.4.*",
        "symfony/asset": "6.4.*"
    },
    "require-dev": {
        "symfony/debug-bundle": "6.4.*",
        "symfony/maker-bundle": "^1.58",
        "symfony/web-profiler-bundle": "6.4.*",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
