{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=cold_chain_logistics;Uid=root;Pwd=password;CharSet=utf8mb4;Pooling=true;MaxPoolSize=100;MinPoolSize=10;ConnectionLifeTime=300;"
  },
  "AppSettings": {
    "SensorDataWindowMinutes": 5,
    "DefaultOfflineThresholdMinutes": 5,
    "AlertEscalationTimeoutMinutes": 30,
    "ReportStoragePath": "Reports",
    "EnableSwagger": true
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  }
}
