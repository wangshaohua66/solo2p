<?xml version="1.0" encoding="UTF-8"?>
<中国专利文献>
  <文献号>CN1000001A</文献号>
  <名称>一种杠杆装置</名称>
  <摘要>本发明公开了一种杠杆装置，包括底座和可转动连接的杠杆。</摘要>
  <申请日>2020-01-15</申请日>
  <公开日>2021-07-20</公开日>
  <申请人>北京机械研究所</申请人>
  <发明人>张三</发明人>
  <分类号>G06F1/00</分类号>
  <权利要求书>
    <权利要求 序号="1" 类型="独立">1. 一种装置，包括底座；包括杠杆，所述杠杆可转动地连接于底座。</权利要求>
    <权利要求 序号="2" 类型="从属" 引用="1">2. 如权利要求1所述的装置，其特征在于所述杠杆为金属杆。</权利要求>
  </权利要求书>
  <引用文献>
    <引用 证号="CN9000001A" 类别="X"/>
    <引用 证号="US8000001B1" 类别="Y"/>
  </引用文献>
</中国专利文献>
