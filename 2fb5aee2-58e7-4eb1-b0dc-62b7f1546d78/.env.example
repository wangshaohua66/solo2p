# ====== 告警配置 ======
# 钉钉机器人告警
DINGTALK_ENABLED=true
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=SECxxx
DINGTALK_MOBILES=13800138000,13900139000
DINGTALK_AT_ALL=false

# 邮件告警
EMAIL_ENABLED=false
EMAIL_HOST=smtp.xxx.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=alert@xxx.com
EMAIL_PASS=password
EMAIL_RECEIVERS=admin@xxx.com,tech@xxx.com

# ====== 性能配置 ======
PERF_MAX_PROCESSING_TIME=90000
PERF_BATCH_RATE=40
PERF_PAGE_TIMEOUT=15000
PERF_RETRY_INTERVAL=5000
PERF_MAX_MEMORY=512
PERF_MAX_CONCURRENT=2
PERF_MAX_LOG_SIZE=50

# ====== 系统配置 ======
LOG_LEVEL=info
LOG_DIR=./logs
REPORT_DIR=./reports
DATA_DIR=./data
SCREENSHOT_DIR=./screenshots
USE_MOCK=false
HEADLESS=true
CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# ====== 当前检测标准 ======
CURRENT_STANDARD=HJ1237-2021
