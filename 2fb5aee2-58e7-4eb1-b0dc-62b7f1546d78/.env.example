# ====== 机构配置 ======
ORG_NAME=某机动车排放检验站
ORG_CODE=33010012345
ORG_ADDRESS=浙江省杭州市某某区某某路123号
ORG_CONTACT=0571-12345678
ORG_LEGAL_PERSON=张三

# ====== 平台配置 ======
# 省级生态环境厅机动车环保检验平台
ENV_PLATFORM_URL=https://hj.epb.xxxx.gov.cn
ENV_PLATFORM_TIMEOUT=15000
ENV_PLATFORM_MAX_RETRIES=3
ENV_PLATFORM_RETRY_INTERVAL=5000

# 公安交管平台
TRAFFIC_PLATFORM_URL=https://gaj.xxxx.gov.cn
TRAFFIC_PLATFORM_TIMEOUT=15000
TRAFFIC_PLATFORM_MAX_RETRIES=3
TRAFFIC_PLATFORM_RETRY_INTERVAL=5000

# ====== 检测线配置（示例） ======
# 可配置8条检测线，每条线独立账号
# 检测线1（汽油车线）
LINE_1_ID=LINE001
LINE_1_NAME=1号检测线
LINE_1_TYPE=汽油车
LINE_1_ENV_USER=user_line1
LINE_1_ENV_PASS=password123
LINE_1_TRAFFIC_USER=traffic_line1
LINE_1_TRAFFIC_PASS=password123
LINE_1_ACTIVE=true

