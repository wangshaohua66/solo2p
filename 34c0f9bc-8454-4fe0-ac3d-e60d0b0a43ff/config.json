            "min": 0,
            "max": 10000,
            "pass": "<=",
            "standard": "GB 4789.2"
          },
          "大肠菌群": {
            "unit": "MPN/100g",
            "min": 0,
            "max": 100,
            "pass": "<=",
            "standard": "GB 4789.3"
          },
          "沙门氏菌": {
            "unit": "/25g",
            "min": 0,
            "max": 0,
            "pass": "==",
            "standard": "GB 4789.4"
          },
          "金黄色葡萄球菌": {
