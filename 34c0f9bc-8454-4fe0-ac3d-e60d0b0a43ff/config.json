        "thresholds": {
          "菌落总数": {
            "unit": "CFU/g",
            "min": 0,
            "max": 5000,
            "pass": "<=",
            "standard": "GB 4789.2(严格)"
          },
          "大肠菌群": {
            "unit": "MPN/100g",
            "min": 0,
            "max": 10,
            "pass": "<=",
