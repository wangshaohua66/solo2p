{
  "name": "default",
  "description": "默认食品安全检测报告模板",
  "version": "2.0.0",
  "header": "食品安全检测报告",
  "sections": [
    { "key": "lab", "label": "实验室", "fields": ["name", "code", "reportId"] },
    { "key": "sample", "label": "样品信息", "fields": ["name", "batch", "category", "source", "producer", "sampler", "sampleDate", "quantity"] },
    { "key": "results", "label": "检测项目", "fields": ["name", "mean", "unit", "judged", "standard"] },
    { "key": "overall", "label": "综合判定", "fields": ["result", "passed", "failed", "pending", "total"] }
  ],
  "outputFormats": ["text", "json"],
  "fields": {
    "reportId": { "label": "报告编号", "width": 24 },
    "name": { "label": "名称/项目", "width": 22 },
    "code": { "label": "代码", "width": 24 },
    "batch": { "label": "批次号", "width": 24 },
    "category": { "label": "检测类别", "width": 24 },
    "source": { "label": "采样来源", "width": 24 },
    "producer": { "label": "生产单位", "width": 24 },
    "sampler": { "label": "采样人员", "width": 24 },
    "sampleDate": { "label": "采样日期", "width": 24 },
    "quantity": { "label": "样品数量", "width": 24 },
    "mean": { "label": "结果(均值)", "width": 12 },
    "unit": { "label": "单位", "width": 12 },
    "judged": { "label": "判定", "width": 8 },
    "standard": { "label": "标准", "width": 17 },
    "result": { "label": "综合结果", "width": 24 },
    "passed": { "label": "合格项目", "width": 24 },
    "failed": { "label": "不合格项目", "width": 24 },
    "pending": { "label": "待检项目", "width": 24 },
    "total": { "label": "项目总数", "width": 24 }
  }
}
