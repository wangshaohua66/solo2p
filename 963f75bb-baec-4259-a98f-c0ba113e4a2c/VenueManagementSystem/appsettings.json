{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,defaultDatabase=0,connectTimeout=5000,syncTimeout=1000,allowAdmin=false"
  },
  "Jwt": {
    "SecretKey": "ThisIsAStrongSecretKeyForVenueManagementSystem1234567890",
    "Issuer": "VenueManagementSystem",
    "Audience": "VenueSystemUsers",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },
  "Hangfire": {
    "WorkerCount": 4,
    "SchedulePollingIntervalSeconds": 10,
    "DashboardPath": "/hangfire"
  }
}
