.status-banner {
  margin: -24rpx -24rpx 24rpx;
  padding: 32rpx;
  text-align: center;
  border-radius: 0 0 32rpx 32rpx;
}

.status-banner.paid { background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%); }
.status-banner.pending { background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%); }
.status-banner.used { background: linear-gradient(135deg, #1677ff 0%, #096dd9 100%); }

.status-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #909399;
}

.info-value {
  color: #333;
}

.qr-card {
  text-align: center;
}

.qr-wrapper {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
}

.qr-tip {
  font-size: 24rpx;
  color: #909399;
  margin-top: 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
