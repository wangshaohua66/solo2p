<view class="container" wx:if="{{order}}">
  <view class="status-banner {{order.status}}">
    <text class="status-text">{{order.statusText || '订单详情'}}</text>
  </view>

  <view class="card">
    <view class="card-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">演出</text>
      <text class="info-value">{{order.performanceName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">座位</text>
      <text class="info-value">{{order.seatsText || order.seatCount}}张</text>
    </view>
    <view class="info-row">
      <text class="info-label">金额</text>
      <text class="price">¥{{order.totalAmount}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createdAt}}</text>
    </view>
  </view>

  <view class="card qr-card" wx:if="{{order.qrCode}}">
    <view class="card-title">入场二维码</view>
    <view class="qr-wrapper">
      <image
        class="qr-image"
        src="{{order.qrCode}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
        bindtap="onSaveQrCode"
      />
    </view>
    <view class="qr-tip">长按二维码可保存到相册</view>
  </view>

  <view class="bottom-bar" wx:if="{{order.status === 'pending'}}">
    <button class="btn-primary" bindtap="onPayTap">立即支付 ¥{{order.totalAmount}}</button>
  </view>
</view>

<view wx:else class="empty">加载中...</view>
