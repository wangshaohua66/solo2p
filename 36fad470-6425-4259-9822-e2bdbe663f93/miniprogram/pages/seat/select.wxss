.stage {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 0 0 50% 50%;
  width: 60%;
  margin: 0 auto 32rpx;
  font-weight: 500;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.seat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.seat {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.seat.available {
  background: #67c23a;
  color: #fff;
}

.seat.sold {
  background: #dcdfe6;
  color: #c0c4cc;
}

.seat.locked {
  background: #f56c6c;
  color: #fff;
}

.seat.selected {
  background: #1677ff;
  color: #fff;
  border: 2rpx solid #096dd9;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.selected-info {
  display: flex;
  flex-direction: column;
}

.selected-count {
  font-size: 26rpx;
  color: #606266;
}

.confirm-btn {
  flex: 1;
  margin-left: 32rpx;
  max-width: 320rpx;
}
