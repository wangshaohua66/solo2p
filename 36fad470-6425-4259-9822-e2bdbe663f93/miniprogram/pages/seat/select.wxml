<view class="container">
  <view class="stage">舞 台</view>

  <view class="section" wx:for="{{sections}}" wx:for-item="section" wx:key="id">
    <view class="section-title">
      {{section.name}} · ¥{{section.basePrice}}
    </view>
    <view class="seat-grid">
      <view
        class="seat {{seat.status === 'available' ? 'available' : seat.status === 'sold' ? 'sold' : 'locked'}} {{seat.isSelected ? 'selected' : ''}}"
        wx:for="{{section.seats}}"
        wx:for-item="seat"
        wx:for-index="seatIdx"
        wx:key="seatIdx"
        data-section-id="{{section.id}}"
        data-row="{{seat.row}}"
        data-col="{{seat.col}}"
        data-status="{{seat.status}}"
        data-price="{{section.basePrice}}"
        bindtap="onSeatTap"
      >
        {{seat.col}}
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="selected-info">
      <text class="selected-count">已选 {{selectedSeats.length}} 个座位</text>
      <text class="price" wx:if="{{selectedSeats.length > 0}}">
        ¥{{totalPrice}}
      </text>
    </view>
    <button class="btn-primary confirm-btn" bindtap="onConfirmTap">确认选座</button>
  </view>
</view>
