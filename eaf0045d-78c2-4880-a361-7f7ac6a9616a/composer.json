{
    "name": "power-trading/green-certificate-platform",
    "description": "电力交易中心绿电交易与绿证核发平台",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.45",
        "laravel/sanctum": "^3.3",
        "laravel/horizon": "^5.22",
        "predis/predis": "^2.2",
        "spatie/laravel-permission": "^6.4",
        "nesbot/carbon": "^2.72"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
