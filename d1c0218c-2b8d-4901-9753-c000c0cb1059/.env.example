# 平台账号凭证 (可选，也可在 config.js 中直接配置)
AMAZON_USERNAME=your_amazon_email@example.com
AMAZON_PASSWORD=your_amazon_password
AMAZON_OTP_SECRET=your_otp_secret_if_applicable

EBAY_USERNAME=your_ebay_username
EBAY_PASSWORD=your_ebay_password

WISH_USERNAME=your_wish_email@example.com
WISH_PASSWORD=your_wish_password

SHOPEE_USERNAME=your_shopee_username
SHOPEE_PASSWORD=your_shopee_password

LAZADA_USERNAME=your_lazada_email@example.com
LAZADA_PASSWORD=your_lazada_password

ALIEXPRESS_USERNAME=your_aliexpress_email@example.com
ALIEXPRESS_PASSWORD=your_aliexpress_password

# 告警通知 Webhook (可选，如飞书/钉钉/企业微信机器人)
ALERT_WEBHOOK_URL=https://your-webhook-url.com/xxx

# 邮件告警配置 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_SENDER=alert@example.com
ALERT_RECIPIENTS=admin1@example.com,admin2@example.com

# Chrome 模式 (false=有界面，方便手动处理验证码/OTP)
CHROME_HEADLESS=false

# 日志级别: debug, info, warn, error
LOG_LEVEL=info
