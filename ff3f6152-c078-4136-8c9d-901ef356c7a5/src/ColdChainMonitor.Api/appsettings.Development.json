{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug"
      }
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "cold_chain_monitor_dev"
  },
  "JwtSettings": {
    "Secret": "DevelopmentSuperSecretKeyForJwtTokenMustBe32CharsMin",
    "Issuer": "ColdChainMonitor-Dev",
    "Audience": "ColdChainMonitorUsers-Dev",
    "AccessTokenExpirySeconds": 7200,
    "RefreshTokenExpiryDays": 7
  }
}
