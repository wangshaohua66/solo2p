{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cold-chain-monitor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "cold_chain_monitor",
    "TemperatureReadingsCollection": "temperature_readings",
    "TransportTasksCollection": "transport_tasks",
    "DevicesCollection": "devices",
    "AlertsCollection": "alerts",
    "AlertRulesCollection": "alert_rules",
    "QualityReportsCollection": "quality_reports",
    "AuditLogsCollection": "audit_logs",
    "UsersCollection": "users",
    "RefreshTokensCollection": "refresh_tokens"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForJwtTokenGenerationMustBeAtLeast32CharactersLong",
    "Issuer": "ColdChainMonitor",
    "Audience": "ColdChainMonitorUsers",
    "AccessTokenExpirySeconds": 7200,
    "RefreshTokenExpiryDays": 7
  }
}
