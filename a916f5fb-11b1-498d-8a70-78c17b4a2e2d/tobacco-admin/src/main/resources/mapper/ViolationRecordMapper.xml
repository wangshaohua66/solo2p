<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tobacco.mapper.ViolationRecordMapper">

    <resultMap id="BaseResultMap" type="com.tobacco.entity.ViolationRecord">
        <id column="id" property="id"/>
        <result column="record_no" property="recordNo"/>
        <result column="task_id" property="taskId"/>
        <result column="retailer_id" property="retailerId"/>
        <result column="retailer_name" property="retailerName"/>
        <result column="county_id" property="countyId"/>
        <result column="violation_type_id" property="violationTypeId"/>
        <result column="violation_type_name" property="violationTypeName"/>
        <result column="severity" property="severity"/>
        <result column="description" property="description"/>
        <result column="evidence" property="evidence"/>
        <result column="credit_deduct" property="creditDeduct"/>
        <result column="disposal_suggestion" property="disposalSuggestion"/>
        <result column="inspector_id" property="inspectorId"/>
        <result column="inspector_name" property="inspectorName"/>
        <result column="disposal_status" property="disposalStatus"/>
        <result column="disposal_user_id" property="disposalUserId"/>
        <result column="disposal_user_name" property="disposalUserName"/>
        <result column="disposal_time" property="disposalTime"/>
        <result column="disposal_result" property="disposalResult"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByRecordNo" resultMap="BaseResultMap">
        SELECT * FROM violation_record WHERE record_no = #{recordNo} AND deleted = 0
    </select>

    <select id="selectByRetailerId" resultMap="BaseResultMap">
        SELECT * FROM violation_record
        WHERE retailer_id = #{retailerId} AND deleted = 0
        ORDER BY create_time DESC
    </select>

    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT * FROM violation_record
        WHERE task_id = #{taskId} AND deleted = 0
        ORDER BY create_time DESC
    </select>

    <select id="selectPendingDisposal" resultMap="BaseResultMap">
        SELECT * FROM violation_record
        WHERE disposal_status = 0 AND deleted = 0
        ORDER BY CASE severity
            WHEN 'high' THEN 1
            WHEN 'medium' THEN 2
            WHEN 'low' THEN 3
            ELSE 4
        END, create_time ASC
    </select>

    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT * FROM violation_record
        WHERE deleted = 0
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="violationType != null">
            AND violation_type = #{violationType}
        </if>
        <if test="countyId != null">
            AND county_id = #{countyId}
        </if>
        <if test="stationId != null">
            AND station_id = #{stationId}
        </if>
        <if test="severity != null and severity != ''">
            AND severity = #{severity}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (retailer_name LIKE CONCAT('%', #{keyword}, '%')
                 OR record_no LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="countViolationsByRetailerAndPeriod" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM violation_record
        WHERE retailer_id = #{retailerId}
          AND deleted = 0
          AND DATE_FORMAT(create_time, '%Y-%m-%d %H:%i:%s') &gt;= #{startTime}
          AND DATE_FORMAT(create_time, '%Y-%m-%d %H:%i:%s') &lt;= #{endTime}
    </select>

    <select id="countViolationsByCountyAndType" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM violation_record
        WHERE county_id = #{countyId}
          AND violation_type = #{violationType}
          AND deleted = 0
          AND DATE_FORMAT(create_time, '%Y-%m') = #{month}
    </select>
</mapper>
