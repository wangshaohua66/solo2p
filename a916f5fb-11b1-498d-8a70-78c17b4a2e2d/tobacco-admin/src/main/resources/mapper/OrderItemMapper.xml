<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tobacco.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.tobacco.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="cigarette_id" property="cigaretteId"/>
        <result column="cigarette_code" property="cigaretteCode"/>
        <result column="cigarette_name" property="cigaretteName"/>
        <result column="brand" property="brand"/>
        <result column="specification" property="specification"/>
        <result column="price" property="price"/>
        <result column="base_quota" property="baseQuota"/>
        <result column="adjusted_quota" property="adjustedQuota"/>
        <result column="quantity" property="quantity"/>
        <result column="amount" property="amount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM order_item
        WHERE order_id = #{orderId} AND deleted = 0
        ORDER BY id
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM order_item
        WHERE order_no = #{orderNo} AND deleted = 0
        ORDER BY id
    </select>

    <select id="sumQuantityByOrderId" resultType="java.lang.Integer">
        SELECT COALESCE(SUM(quantity), 0) FROM order_item
        WHERE order_id = #{orderId} AND deleted = 0
    </select>
</mapper>
